# PredictAI local development configuration.
# Copy this file to .env at the repository root:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# Only variables that start with VITE_ are exposed to the browser.
# Do not put credentials in VITE_ variables.

# ---- Backend (FastAPI) ----
# development | test | staging | production
PREDICTAI_ENV=development
PREDICTAI_API_HOST=127.0.0.1
PREDICTAI_API_PORT=8000
# Comma-separated explicit origins allowed to call the API from a browser.
PREDICTAI_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PREDICTAI_LOG_LEVEL=INFO
# text | json
PREDICTAI_LOG_FORMAT=text
# Serves /api/v1/docs and /api/v1/openapi.json
PREDICTAI_API_DOCS_ENABLED=true

# ---- Identity & security (Phase 2) ----
# Development works with none of these: a random secret is generated into data/dev-secret-key
# (git-ignored) and verification emails are written to data/outbox/*.eml so you can open the links.
# Where the web app is served (used in email links, CORS and OAuth redirects).
PREDICTAI_FRONTEND_BASE_URL=http://localhost:5173
# Production REQUIRES a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PREDICTAI_SECRET_KEY=
# SQLite file (default data/predictai.db). Migrations run automatically in development.
# PREDICTAI_DATABASE_PATH=
# ---- Database backend (Phase 11) ----
# sqlite (default): the local file above. turso: a remote libSQL database on Turso (production on Render). Local development never needs Turso.
# PREDICTAI_DATABASE_BACKEND=sqlite
# Only when PREDICTAI_DATABASE_BACKEND=turso (needs: pip install -r backend/requirements-turso.txt):
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=            # from: turso db tokens create <database>   (a secret: never commit it, never paste it into the frontend)
# PREDICTAI_TURSO_MODE=remote  # remote (every query goes to Turso) or replica (reads from a local copy; experimental, see docs/PHASE11_TURSO_DATABASE_INTEGRATION.md)
# PREDICTAI_TURSO_REPLICA_PATH=
# PREDICTAI_TURSO_SYNC_INTERVAL=0
# Apply pending migrations at start-up (default: on in development, off when hosted; hosted deployments run `python -m app.cli migrate`).
# PREDICTAI_AUTO_MIGRATE=true
# Session cookie. Hosted environments force Secure and the __Host- prefix; override only for a special reason.
# PREDICTAI_COOKIE_SECURE=false
# PREDICTAI_SESSION_COOKIE_NAME=pai_session
# Where the development email backend writes .eml files (default data/outbox).
# PREDICTAI_EMAIL_OUTBOX_DIR=
# ---- Projects, uploads and extraction (Phase 3) ----
# Where original files and extracted data are stored (default data/storage). Outside the web root; use a persistent disk in production.
# PREDICTAI_STORAGE_DIR=
# Largest accepted file and largest single upload request, in MB. Large files are sent in parts, resumable after a break.
# PREDICTAI_UPLOAD_MAX_MB=50
# PREDICTAI_UPLOAD_CHUNK_MAX_MB=4
# How long an unfinished upload can be resumed before it is cleaned up.
# PREDICTAI_UPLOAD_SESSION_TTL_HOURS=24
# Standard-account limits (Special and Owner accounts are unlimited through their existing permission).
# PREDICTAI_STANDARD_MAX_DOCUMENTS=3
# PREDICTAI_STANDARD_MAX_PAGES=100
# Dataset safety limits.
# PREDICTAI_PARSE_MAX_ROWS=500000
# PREDICTAI_PARSE_MAX_COLUMNS=1000
# OCR for scanned PDFs uses the free local `tesseract` and `pdftoppm` programs. Without them scanned pages are reported, not guessed.
# PREDICTAI_OCR_ENABLED=true
# PREDICTAI_OCR_LANGUAGES=eng   # e.g. eng+hin (the language data must be installed)
# PREDICTAI_OCR_MAX_PAGES=300
# Minutes an unconfirmed cleaning preview stays valid.
# PREDICTAI_PREVIEW_TTL_MINUTES=60
# Sessions: idle timeout and hard limit. Owners get stricter limits.
PREDICTAI_SESSION_IDLE_MINUTES=1440
PREDICTAI_SESSION_ABSOLUTE_HOURS=168
PREDICTAI_OWNER_SESSION_IDLE_MINUTES=60
PREDICTAI_OWNER_SESSION_ABSOLUTE_HOURS=12
# Minutes a password confirmation unlocks sensitive owner actions.
PREDICTAI_STEP_UP_MINUTES=10
# Failed sign-ins per account before a temporary lockout, and its length.
PREDICTAI_LOGIN_MAX_FAILURES=5
PREDICTAI_LOGIN_LOCKOUT_MINUTES=15
# How long security audit records are kept.
PREDICTAI_AUDIT_RETENTION_DAYS=365
PREDICTAI_MAX_OWNERS=3
PREDICTAI_REQUIRE_EMAIL_VERIFICATION=false
PREDICTAI_NOTIFY_SECURITY_EVENTS=true
# Email: file (writes .eml files, development only) | smtp | disabled
PREDICTAI_EMAIL_BACKEND=file
# PREDICTAI_EMAIL_FROM=PredictAI <no-reply@example.com>
# SMTP (only when the backend is smtp). Any provider's free tier or your own server works.
# PREDICTAI_SMTP_HOST=
# PREDICTAI_SMTP_PORT=587
# PREDICTAI_SMTP_SECURITY=starttls   # starttls | ssl
# PREDICTAI_SMTP_USERNAME=
# PREDICTAI_SMTP_PASSWORD=
# Continue with Google / GitHub (sign in, register, and connect to an existing account). Free; no billing is involved.
# Leave the pair empty to keep a provider switched off; the sign-in pages then say so honestly. Each provider needs BOTH values.
#   Google : Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application)
#   GitHub : GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Register this redirect (callback) URI with the provider, with the provider name in place of <provider>:
#   <PREDICTAI_OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/<provider>/callback      e.g. http://localhost:5173/api/v1/auth/oauth/google/callback
# The base defaults to PREDICTAI_FRONTEND_BASE_URL (the Vite dev server proxies /api); set it to the public API origin if that differs.
# The client secrets are read by the backend only and never reach the browser bundle. Keep them out of git.
# Use EXACTLY these names (not GOOGLE_CLIENT_ID etc.), in the .env at the repository root, with no quotes needed.
# Settings are read once at start-up: RESTART the API after editing. To see what the server found (names only, never
# values):   cd backend && python -m app.cli oauth-status
# PREDICTAI_OAUTH_REDIRECT_BASE_URL=
# PREDICTAI_OAUTH_GOOGLE_CLIENT_ID=
# PREDICTAI_OAUTH_GOOGLE_CLIENT_SECRET=
# PREDICTAI_OAUTH_GITHUB_CLIENT_ID=
# PREDICTAI_OAUTH_GITHUB_CLIENT_SECRET=
# Number of reverse proxies in front of the API (so the real client IP is used for rate limits).
# PREDICTAI_TRUSTED_PROXY_COUNT=0

# ---- Frontend (Vite) ----
# Base URL of the API. A relative path uses the dev-server proxy below.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server forwards /api requests.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=8000
# 0 disables background polling of the health endpoint.
VITE_HEALTH_POLL_INTERVAL_MS=30000
# ---- Analytics, insights and the assistant (Phase 4) ----
# How analyses are executed. 'subprocess' (default) runs each one in a separate, resource-limited process with a scrubbed environment and a
# private temporary copy of the table. 'inprocess' runs inside the API process (tests and tiny single-user setups only; refused when hosted).
# PREDICTAI_ANALYTICS_ISOLATION=subprocess
# Optional wording help from a LOCAL model (Ollama, free). Off by default: answers are built from verified figures without any model.
# Even when on, a request must opt in with "use AI"; only the question and the computed figures are sent (never rows), and any
# number the model writes that is not in the results is discarded.
# PREDICTAI_AI_PROVIDER=none          # none | ollama
# PREDICTAI_AI_BASE_URL=http://127.0.0.1:11434
# PREDICTAI_AI_MODEL=                 # e.g. llama3.2 (you must have pulled it with `ollama pull`)
# PREDICTAI_AI_TIMEOUT_SECONDS=60
# A non-loopback host sends figures off this machine; refused unless you set this to true on purpose.
# PREDICTAI_AI_ALLOW_REMOTE_HOST=false

# ---- Predictive modelling and AutoML (Phase 5) ----
# How training and prediction run. 'subprocess' (default) runs each task in a separate, resource-limited process with a scrubbed environment and a
# private temporary copy of the table; it can be cancelled and cannot see application secrets. 'inprocess' runs inside the API process
# (tests and tiny single-user setups only; refused when hosted).
# PREDICTAI_ML_ISOLATION=subprocess
# How many training jobs may run at once across all users (1-8). Each person is still limited to the active-job count of their plan.
# PREDICTAI_ML_WORKERS=2

# ---- Research & World Intelligence (Phase 6) ----
# Everything outbound is OFF. Web research needs this switch AND the person's own opt-in AND the project's (a project can only narrow), and the person approves the exact search phrases first.
# PREDICTAI_RESEARCH_WEB_ENABLED=false
# Address of a SearXNG instance you run yourself (the only general web search provider; http(s) only, no credentials).
# Wikipedia (official MediaWiki API) and arXiv (official API) need no address, only the switch above and the contact below.
# A stock SearXNG answers 403 to API requests; use the ready-made, local-only setup in docker/searxng (see its README: `docker compose up -d`).
# PREDICTAI_SEARXNG_URL=http://127.0.0.1:8080
# Your contact (email or URL) is sent in the User-Agent. Wikimedia and arXiv ask automated clients to identify themselves, and either may refuse requests that do not.
# PREDICTAI_RESEARCH_CONTACT=
# Background research and news jobs that may run at once across all users (1-8).
# PREDICTAI_RESEARCH_WORKERS=2
# Saved copies of web pages: hours kept (1-720), total size cap in MB (1-5000), seconds to wait for one page (3-60).
# PREDICTAI_RESEARCH_CACHE_HOURS=24
# PREDICTAI_RESEARCH_CACHE_MAX_MB=100
# PREDICTAI_RESEARCH_FETCH_TIMEOUT_SECONDS=15
# Development only: lets research fetches reach private addresses (for example a local SearXNG or test server). Refused when hosted.
# PREDICTAI_RESEARCH_ALLOW_PRIVATE_NETWORK=false
# A provider marked paid stays off unless this is true AND the owner enables it with a budget. Nothing paid is ever switched on automatically.
# PREDICTAI_AI_ALLOW_PAID=false

# ---- Phase 7: reports, collaboration, scheduling, owner operations ----
# Standard-account limits (the owner can override them in Owner controls > Limits; Special access lifts them).
# PREDICTAI_STANDARD_MAX_DOCUMENTS=3
# PREDICTAI_STANDARD_MAX_PAGES=100
# Scheduled reports run only when backend/scripts/run_schedules.py is run (for example every 5 minutes from cron or launchd). Nothing runs inside the web server.
# Email delivery of scheduled reports needs PREDICTAI_EMAIL_BACKEND=smtp and the SMTP settings above. Slack needs an incoming-webhook URL (https://hooks.slack.com/...).
# Without them, only the "keep in PredictAI" delivery is available and the interface says so.
# PREDICTAI_P7_SLACK_WEBHOOK_URL=

# ---- Phase 8: first owner and research limits ----
# First owner, created ONCE by the server at start-up (or with `python -m app.cli bootstrap-owner`) when no owner exists yet. Put real values only in your private .env, never in this file.
# After an owner exists these are ignored: they cannot add a second owner and cannot change an existing owner's password (use `python -m app.cli recover-owner` for that).
# The password must meet the normal password rules. The plain names OWNER_NAME / OWNER_EMAIL / OWNER_PASSWORD / OWNER_ACTIVATION_CODE are accepted too; the PREDICTAI_ names win.
# PREDICTAI_OWNER_NAME=
# PREDICTAI_OWNER_EMAIL=
# PREDICTAI_OWNER_PASSWORD=
# Optional. Must look like PAI-XXXXX-XXXXX-XXXXX-XXXXX (100 bits; letters/digits without I, L, O, U). Stored only as a hash, works once for one account, expires after 30 days.
# PREDICTAI_OWNER_ACTIVATION_CODE=
# Research workspaces (foundation for Research Intelligence). Standard accounts: workspaces per account and sources per workspace (the owner can override in Owner controls > Limits).
# Special and Owner accounts are not limited by those, but never go past the safeguard ceilings, which protect the server.
# PREDICTAI_STANDARD_MAX_RESEARCH_WORKSPACES=5
# PREDICTAI_STANDARD_MAX_RESEARCH_SOURCES=20
# PREDICTAI_SAFEGUARD_MAX_RESEARCH_WORKSPACES=200
# PREDICTAI_SAFEGUARD_MAX_RESEARCH_SOURCES=500

# ---- Phase 9: Development Workspace (code files, notebooks, environments, jobs, Git, pipelines, experiments, compute) ----
# Only people with Special access can open it. Code NEVER runs inside the web server: jobs run in a separate worker process (python backend/scripts/run_dev_worker.py).
#   off           (default) nothing executes; files, history and records still work.
#   local_trusted ONE trusted person on their own machine. Jobs run in a child process with CPU/memory/time/output/process limits, a scrubbed environment and, on Linux, no network and a private
#                 process/mount namespace. On macOS the no-network rule uses sandbox-exec (deprecated by Apple; verify it on your Mac). NOT a multi-user sandbox. Refused when hosted.
#   docker        Jobs run in a locked-down container (no network, read-only root, all capabilities dropped, limits). Requires Docker; the Docker socket is never mounted. Unverified until you test it.
# PREDICTAI_DEV_EXECUTION=off
# PREDICTAI_DEV_ROOT=
# PREDICTAI_DEV_DOCKER_IMAGE=python:3.12-slim
# Optional servers (not bundled). Offered only in local_trusted mode: JupyterLab and a browser IDE such as code-server (free, open source). Empty = look on PATH.
# PREDICTAI_DEV_JUPYTER_COMMAND=
# PREDICTAI_DEV_IDE_COMMAND=
# Packages come from wheels only, from these https indexes (comma separated) or from a local folder of wheels (PREDICTAI_DEV_WHEELHOUSE, which also works offline).
# PREDICTAI_DEV_PIP_INDEX_URLS=https://pypi.org/simple
# PREDICTAI_DEV_WHEELHOUSE=
# Git: hosts a project may connect to, and whether a local folder may be used as a remote (local installs only; ignored when hosted).
# PREDICTAI_DEV_GIT_HOSTS=github.com,gitlab.com
# PREDICTAI_DEV_GIT_ALLOW_LOCAL=false
# Pipelines are a feature flag (off by default). Deployment is not available in this release and cannot be switched on from the environment.
# PREDICTAI_DEV_PIPELINES_ENABLED=false
# Per-job and per-person limits (the platform owner can override them per person or project in Owner controls, with a recorded reason).
# PREDICTAI_DEV_JOB_WALL_SECONDS=300
# PREDICTAI_DEV_JOB_CPU_SECONDS=300
# PREDICTAI_DEV_JOB_MEMORY_MB=512
# PREDICTAI_DEV_JOB_OUTPUT_KB=1024
# PREDICTAI_DEV_JOB_MAX_PROCS=32
# PREDICTAI_DEV_JOB_STORAGE_MB=200
# PREDICTAI_DEV_USER_CONCURRENCY=1
# PREDICTAI_DEV_PROJECT_CONCURRENCY=1
# PREDICTAI_DEV_QUEUE_DEPTH=20
# PREDICTAI_DEV_PROJECT_STORAGE_MB=200
# PREDICTAI_DEV_USER_CPU_SECONDS_PER_DAY=3600
# PREDICTAI_DEV_IDLE_MINUTES=30
# PREDICTAI_DEV_MAX_SESSIONS=2

# ---------------------------------------------------------------- Phase 10: Research Intelligence (all optional)
# PREDICTAI_RI_ROOT=                      # where originals are stored (default: <storage>/ri)
# PREDICTAI_RI_MAX_UPLOAD_MB_STANDARD=10
# PREDICTAI_RI_MAX_UPLOAD_MB_SPECIAL=50
# PREDICTAI_RI_PDF_MAX_PAGES=400
# PREDICTAI_RI_AI_REQUESTS_PER_DAY_STANDARD=30
# PREDICTAI_RI_IMPORTS_PER_DAY_STANDARD=40
# PREDICTAI_RI_VECTOR_BACKEND=sqlite      # sqlite | qdrant (qdrant is UNVERIFIED against a live server)
# PREDICTAI_RI_QDRANT_URL=http://127.0.0.1:6333
# PREDICTAI_RI_QDRANT_API_KEY=            # environment only; never stored
# PREDICTAI_RI_MALWARE_SCAN=auto          # auto | off | required
# PREDICTAI_RI_ALLOW_PRIVATE_URLS=false   # ignored when hosted
# PREDICTAI_RI_CROSSREF_MAILTO=
# PREDICTAI_RI_CROSSREF_MAILTO is also sent as the polite-pool contact to OpenAlex.
# --- discovery (R2): providers searched when a request names none (comma list of: crossref, openalex, arxiv, semanticscholar, searxng)
# PREDICTAI_RI_DISCOVERY_PROVIDERS=crossref,openalex,arxiv,semanticscholar
# PREDICTAI_RI_DISCOVERY_PER_PROVIDER=25   # 5-100 results asked of each provider
# PREDICTAI_RI_DISCOVERY_TIMEOUT_S=15
# PREDICTAI_RI_DISCOVERY_HISTORY_MAX=100   # searches kept per person; older ones are removed
# PREDICTAI_RI_OPENALEX_API_KEY=           # OpenAlex now asks for a free API key; environment only, never stored or returned
# PREDICTAI_RI_SEMANTIC_SCHOLAR_API_KEY=   # optional (higher limits); environment only, never stored or returned
# --- multi-source analysis (R5)
# PREDICTAI_RI_ANALYSES_PER_DAY_STANDARD=10
# PREDICTAI_RI_ANALYSES_PER_DAY_SPECIAL=100
# PREDICTAI_RI_ANALYSIS_MAX_SOURCES=100    # 2-300 sources compared in one analysis
