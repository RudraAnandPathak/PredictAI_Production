# Example production overrides. Copy the values into your hosting provider's
# environment settings (do not commit a filled-in copy). Domains are placeholders.

PREDICTAI_ENV=production
# Required in staging/production. Must be https origins. An empty value means
# same-origin only.
PREDICTAI_CORS_ALLOWED_ORIGINS=https://app.example.com
PREDICTAI_LOG_LEVEL=INFO
PREDICTAI_LOG_FORMAT=json
PREDICTAI_API_DOCS_ENABLED=false

# Identity & security. The API refuses to start in production without these.
# Long random secret (python -c "import secrets; print(secrets.token_urlsafe(48))"); keep it in the host's secret store.
PREDICTAI_SECRET_KEY=<generate-and-store-as-a-secret>
# Must be https. Sessions use a Secure, __Host- prefixed cookie, which needs https and no Domain attribute.
PREDICTAI_FRONTEND_BASE_URL=https://app.example.com
# ---- Database (Phase 11) ----
# On Render (and any host without a persistent disk) use Turso. SQLite on Render's temporary disk is refused in production.
PREDICTAI_DATABASE_BACKEND=turso
TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# Secret: set it in the host's secret store only. Create it with: turso db tokens create <database>
TURSO_AUTH_TOKEN=<set-in-the-host-secret-store>
PREDICTAI_TURSO_MODE=remote
# Migrations do not run on start-up when hosted; run `python -m app.cli migrate` before starting (see docs/PHASE11_TURSO_DATABASE_INTEGRATION.md).
PREDICTAI_AUTO_MIGRATE=false
# For a self-hosted server WITH a persistent disk you may keep SQLite instead:
# PREDICTAI_DATABASE_BACKEND=sqlite
# PREDICTAI_DATABASE_PATH=/var/lib/predictai/predictai.db
# ---- Projects, uploads and extraction (Phase 3) ----
# Where original files and extracted data are stored (default data/storage). Outside the web root; use a persistent disk in production.
PREDICTAI_STORAGE_DIR=/var/lib/predictai/storage
# Largest accepted file and largest single upload request, in MB. Large files are sent in parts, resumable after a break.
# PREDICTAI_UPLOAD_MAX_MB=50
# PREDICTAI_UPLOAD_CHUNK_MAX_MB=4
# How long an unfinished upload can be resumed before it is cleaned up.
# PREDICTAI_UPLOAD_SESSION_TTL_HOURS=24
# Standard-account limits (Special and Owner accounts are unlimited through their existing permission).
# PREDICTAI_STANDARD_MAX_DOCUMENTS=3
# PREDICTAI_STANDARD_MAX_PAGES=100
# Dataset safety limits.
# PREDICTAI_PARSE_MAX_ROWS=500000
# PREDICTAI_PARSE_MAX_COLUMNS=1000
# OCR for scanned PDFs uses the free local `tesseract` and `pdftoppm` programs. Without them scanned pages are reported, not guessed.
# PREDICTAI_OCR_ENABLED=true
# PREDICTAI_OCR_LANGUAGES=eng   # e.g. eng+hin (the language data must be installed)
# PREDICTAI_OCR_MAX_PAGES=300
# Minutes an unconfirmed cleaning preview stays valid.
# PREDICTAI_PREVIEW_TTL_MINUTES=60
# The file email backend is refused in production. Use SMTP (any free-tier provider) or you will get no reset emails.
PREDICTAI_EMAIL_BACKEND=smtp
PREDICTAI_EMAIL_FROM=PredictAI <no-reply@example.com>
PREDICTAI_SMTP_HOST=smtp.example.com
PREDICTAI_SMTP_PORT=587
PREDICTAI_SMTP_SECURITY=starttls
PREDICTAI_SMTP_USERNAME=<smtp-user>
PREDICTAI_SMTP_PASSWORD=<smtp-password>
# Optional: Continue with Google / GitHub. Leave a pair unset to keep that provider off; both values of a pair are required.
# Register <PREDICTAI_OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/<provider>/callback with the provider. Must be https in production.
# Store the secrets in the host's secret store, never in git or in VITE_ variables.
# PREDICTAI_OAUTH_REDIRECT_BASE_URL=https://api.example.com
# PREDICTAI_OAUTH_GOOGLE_CLIENT_ID=<from-google-cloud-console>
# PREDICTAI_OAUTH_GOOGLE_CLIENT_SECRET=<store-as-a-secret>
# PREDICTAI_OAUTH_GITHUB_CLIENT_ID=<from-github-oauth-app>
# PREDICTAI_OAUTH_GITHUB_CLIENT_SECRET=<store-as-a-secret>
# Optional tuning (defaults shown). Hosted environments use a Secure, __Host- prefixed session cookie automatically.
# PREDICTAI_API_HOST=0.0.0.0
# PREDICTAI_API_PORT=8000
# PREDICTAI_AUTO_MIGRATE=false           # run `python -m app.cli migrate` as a deploy step instead
# PREDICTAI_REQUIRE_EMAIL_VERIFICATION=true
# PREDICTAI_SESSION_IDLE_MINUTES=1440
# PREDICTAI_SESSION_ABSOLUTE_HOURS=168
# PREDICTAI_OWNER_SESSION_IDLE_MINUTES=60
# PREDICTAI_OWNER_SESSION_ABSOLUTE_HOURS=12
# PREDICTAI_STEP_UP_MINUTES=10
# PREDICTAI_LOGIN_MAX_FAILURES=5
# PREDICTAI_LOGIN_LOCKOUT_MINUTES=15
# PREDICTAI_AUDIT_RETENTION_DAYS=365
# PREDICTAI_MAX_OWNERS=3
# PREDICTAI_NOTIFY_SECURITY_EVENTS=true
# Set to the number of reverse proxies in front of the API so rate limits see real client IPs.
PREDICTAI_TRUSTED_PROXY_COUNT=1

# Analytics (Phase 4). Hosted deployments always use the isolated subprocess executor. AI explanations are optional and off by default.
# PREDICTAI_ANALYTICS_ISOLATION=subprocess
# PREDICTAI_AI_PROVIDER=none

# Predictive modelling (Phase 5). Hosted deployments always use the isolated subprocess executor. ML_WORKERS is how many training jobs may run at once
# across all users (1-8); each job can use up to the memory limit of its plan, so size it to the server.
# PREDICTAI_ML_ISOLATION=subprocess
# PREDICTAI_ML_WORKERS=2

# ---- Research & World Intelligence (Phase 6) ----
# Everything outbound is OFF. Web research needs this switch AND the person's own opt-in AND the project's (a project can only narrow), and the person approves the exact search phrases first.
# PREDICTAI_RESEARCH_WEB_ENABLED=false
# Address of a SearXNG instance you run yourself (the only general web search provider; http(s) only, no credentials).
# Wikipedia (official MediaWiki API) and arXiv (official API) need no address, only the switch above and the contact below.
# A stock SearXNG answers 403 to API requests; use the ready-made, local-only setup in docker/searxng (see its README: `docker compose up -d`).
# PREDICTAI_SEARXNG_URL=http://127.0.0.1:8080
# Your contact (email or URL) is sent in the User-Agent. Wikimedia and arXiv ask automated clients to identify themselves, and either may refuse requests that do not.
# PREDICTAI_RESEARCH_CONTACT=
# Background research and news jobs that may run at once across all users (1-8).
# PREDICTAI_RESEARCH_WORKERS=2
# Saved copies of web pages: hours kept (1-720), total size cap in MB (1-5000), seconds to wait for one page (3-60).
# PREDICTAI_RESEARCH_CACHE_HOURS=24
# PREDICTAI_RESEARCH_CACHE_MAX_MB=100
# PREDICTAI_RESEARCH_FETCH_TIMEOUT_SECONDS=15
# Development only: lets research fetches reach private addresses (for example a local SearXNG or test server). Refused when hosted.
# PREDICTAI_RESEARCH_ALLOW_PRIVATE_NETWORK=false
# A provider marked paid stays off unless this is true AND the owner enables it with a budget. Nothing paid is ever switched on automatically.
# PREDICTAI_AI_ALLOW_PAID=false

# First owner (Phase 8). Set these only in your private .env for the first start, then REMOVE the password. Ignored once an owner exists. Never commit real values.
# PREDICTAI_OWNER_NAME=
# PREDICTAI_OWNER_EMAIL=
# PREDICTAI_OWNER_PASSWORD=
# PREDICTAI_OWNER_ACTIVATION_CODE=

# Development Workspace (Phase 9). Keep code execution OFF on a hosted server: local_trusted is refused when hosted, and docker isolation is not verified for untrusted users.
# PREDICTAI_DEV_EXECUTION=off
# PREDICTAI_DEV_PIPELINES_ENABLED=false
# PREDICTAI_DEV_GIT_HOSTS=github.com,gitlab.com

# Frontend build-time value (static hosting). Point it at the deployed API.
VITE_API_BASE_URL=https://api.example.com/api/v1
